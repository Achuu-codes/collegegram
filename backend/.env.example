# CollegeGram backend configuration
#
# Copy this file to `.env` and fill in the values:
#     cp .env.example .env
#
# `.env` is gitignored and must NEVER be committed. This file is committed and
# must therefore never contain a real secret.
#
# Every variable here is parsed and validated at boot by src/config/index.js.
# The process refuses to start if a required value is missing or malformed.

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
NODE_ENV=development
# 5050, not 5000: macOS binds 5000 to the AirPlay Receiver service by default.
PORT=5050
LOG_LEVEL=debug

# ---------------------------------------------------------------------------
# MongoDB
# ---------------------------------------------------------------------------
# Local development. Requires a running mongod (`brew services start
# mongodb-community`).
MONGODB_URI=mongodb://127.0.0.1:27017/collegegram

# Separate database for the test suite, which DROPS COLLECTIONS between runs.
# Pointing this at your development or production database will destroy data.
MONGODB_URI_TEST=mongodb://127.0.0.1:27017/collegegram_test

# For deployment, replace MONGODB_URI with an Atlas SRV string of the form:
#   mongodb+srv://<user>:<password>@<cluster>.mongodb.net/collegegram?retryWrites=true&w=majority
# Never commit that string.

# ---------------------------------------------------------------------------
# Redis
# ---------------------------------------------------------------------------
# Requires a running redis-server (`brew services start redis`).
# The application degrades to MongoDB-only if Redis is unreachable; it does not
# fail to start.
REDIS_URL=redis://127.0.0.1:6379

# ---------------------------------------------------------------------------
# Authentication secrets  >>> YOU MUST GENERATE THESE <<<
# ---------------------------------------------------------------------------
# Generate each one separately with:
#     node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
#
# These are the HMAC keys used to sign JWTs. Anyone holding one can mint tokens
# and impersonate any user, so treat them like passwords:
#   - minimum 32 characters (enforced at boot)
#   - two DIFFERENT values, so a leaked access secret cannot mint refresh tokens
#   - different values per environment; never reuse the dev secret in production
#   - rotating a secret invalidates every token signed with it (i.e. logs
#     everyone out), which is exactly what you want after a suspected leak
JWT_ACCESS_SECRET=replace-me-with-48-random-bytes-base64url
JWT_REFRESH_SECRET=replace-me-with-a-DIFFERENT-48-random-bytes

# Access tokens are short-lived because they cannot be revoked individually
# before expiry; refresh tokens are long-lived but are rotated and revocable.
# Accepts s/m/h/d suffixes.
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d

# bcrypt work factor. Each +1 doubles the time to hash AND to brute-force.
# Raise it as hardware improves; 12 is a reasonable 2026 default.
BCRYPT_COST=12

# ---------------------------------------------------------------------------
# HTTP
# ---------------------------------------------------------------------------
# Comma-separated allowlist of browser origins permitted to call this API with
# credentials. Must NOT be "*" — see the CORS comment in src/app.js.
CORS_ORIGINS=http://localhost:5173

JSON_BODY_LIMIT=64kb
SHUTDOWN_TIMEOUT_MS=10000
